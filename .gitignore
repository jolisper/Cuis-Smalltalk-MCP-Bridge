#macOS custom attributes
.DS_Store

#Cuis distribution, fetched on demand by tools/fetch-cuis.sh — not versioned
Cuis7-8-main/
Cuis7-8-main.zip

#Generated user changes log snapshots (VM writes these wherever it happens to run from)
UserChanges/

#Generated Cuis user files (change logs, new packages) — nothing here is versioned
Cuis7-8-main-UserFiles/

#Frozen image/sources/changes cache for tools/run-headless-tests.sh, lazily
#rebuilt from Cuis7-8-main.zip — not versioned, regenerated on demand
.headless-base/

#OpenSmalltalk VM source, fetched on demand by tools/fetch-vm.sh — not versioned
opensmalltalk-vm/

#Compiled plugin build output (.o files, .bundle binaries) for plugins built
#outside the opensmalltalk-vm tree (e.g. Zig plugins) — not versioned, rebuilt
#from vm-exploration/plugins/*/ source on demand
vm-exploration/build/

#Transcript logs the VM writes wherever it happens to run from (e.g. interactive
#GUI launches from the repo root) — not versioned
Logs/

#build.zig's own cache — not versioned, rebuilt on demand
.zig-cache/

node_modules/

#spec-partition working files (graph, plan, prose) — regenerated by /spec-partition
initiatives/*/.partition/
initiatives/_archive/*/.partition/
